# ═══════════════════════════════════════════════════════════════════════════
# avRoN Tech Platform - Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ─── Server Configuration ─────────────────────────────────────────────────────
BASE_URL=https://yourdomain.com
PORT=3000
NODE_ENV=production

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# Get free MongoDB Atlas cluster at: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ─── Email Service (Choose One) ───────────────────────────────────────────────

## Option 1: Gmail (Development/Testing)
## Get app password: https://myaccount.google.com/apppasswords
EMAIL_USER=yourmail@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password

## Option 2: Brevo (Production Recommended)
## Sign up: https://www.brevo.com/
## Get API key from: Account → SMTP & API → API Keys
BREVO_SMTP_KEY=your_brevo_api_key_here
BREVO_SMTP_USER=support@yourdomain.com

## Option 3: Resend (Alternative)
## Sign up: https://resend.com/
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=avRoN Tech <noreply@yourdomain.com>

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate strong secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be at least 32 characters!
JWT_SECRET=your_random_32_char_minimum_secret_here_generate_with_command_above
JWT_EXPIRES_IN=7d

# ─── UPI Payment Details ──────────────────────────────────────────────────────
UPI_ID=yourphonenumber@ybl
UPI_NAME=Your Company Name
UPI_AMOUNT=299

# ─── Admin Credentials ────────────────────────────────────────────────────────
ADMIN_KEY=your_secret_admin_key_for_test_endpoints
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=StrongPassword@123!WithSpecialChars

# Multiple admins (optional):
# ADMIN_2_EMAIL=admin2@yourdomain.com
# ADMIN_2_PASSWORD=AnotherStrongPassword@456
# ADMIN_2_NAME=Admin Two

# ─── Application Settings ─────────────────────────────────────────────────────
SUPPORT_EMAIL=support@yourdomain.com
CERT_VALIDITY_YEARS=2

# ─── Early Bird Offer ─────────────────────────────────────────────────────────
# Set once at launch. Format: YYYY-MM-DDTHH:mm:ss
# Never change after deployment (redeployments won't affect it)
EARLY_BIRD_END_DATE=2026-12-31T23:59:59

# ─── CORS Configuration ───────────────────────────────────────────────────────
# Development: use * (allows all origins)
# Production: MUST specify exact domains (comma-separated)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# ─── Redis (Optional - For Email Queue) ──────────────────────────────────────
# Get free Redis from: https://redis.com/try-free/ or Railway.app
# Leave empty to use direct email sending (works fine for <1000 emails/day)
# REDIS_URL=redis://default:password@hostname:port

# ─── Razorpay Payment Gateway (Optional) ──────────────────────────────────────
# Sign up: https://razorpay.com/
# Get credentials from: Settings → API Keys
# RAZORPAY_KEY_ID=rzp_live_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_secret

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY CHECKLIST:
# ═══════════════════════════════════════════════════════════════════════════
# [ ] .env is in .gitignore (CRITICAL!)
# [ ] JWT_SECRET is at least 32 random characters
# [ ] ADMIN_PASSWORD is strong (12+ chars, mixed case, numbers, symbols)
# [ ] All passwords/keys are unique (not reused from other services)
# [ ] ALLOWED_ORIGINS is specific domain(s), not * in production
# [ ] MONGODB_URI uses strong password
# [ ] Database user has minimal required permissions
# [ ] Email credentials are API keys, not account passwords
# [ ] Rotate all secrets if .env was ever committed to git
#
# Generate secure random strings:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Verify .env is gitignored:
# git check-ignore .env    (should output: .env)
#
# ═══════════════════════════════════════════════════════════════════════════
